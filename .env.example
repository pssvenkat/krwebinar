# Environment Variables

# Copy this file to .env.local for local development
# NEVER commit .env or .env.local to version control

# ─────────────────────────────────────────────────────────────────
# FRONTEND (Vite — prefix with VITE_ to expose to browser)
# ─────────────────────────────────────────────────────────────────

# URL of the Cloudflare Worker API in development
VITE_API_URL=http://localhost:8787

# Cloudflare Turnstile site key (public — safe to expose to browser)
# Get from: https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# ─────────────────────────────────────────────────────────────────
# WORKER SECRETS (set via: wrangler secret put SECRET_NAME)
# These are NEVER stored in .env files — set them via Wrangler CLI
# ─────────────────────────────────────────────────────────────────

# JWT signing secret for admin sessions (min 32 chars, random)
# wrangler secret put JWT_SECRET
# JWT_SECRET=

# Cloudflare Turnstile secret key (server-side verification)
# wrangler secret put TURNSTILE_SECRET_KEY
# TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY (.dev.vars — Wrangler reads this file)
# Copy secrets here for local dev ONLY, never commit this file
# ─────────────────────────────────────────────────────────────────
# Create .dev.vars with:
# JWT_SECRET=local-dev-secret-min-32-chars-xxxxxxxxx
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  (test key)

# ─────────────────────────────────────────────────────────────────
# CLOUDFLARE RESOURCE IDs (set in wrangler.toml, not here)
# ─────────────────────────────────────────────────────────────────
# D1 database_id — update in wrangler.toml after running:
#   wrangler d1 create krwebinar-db
#
# R2 bucket — update in wrangler.toml after running:
#   wrangler r2 bucket create krwebinar-assets
